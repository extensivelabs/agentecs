[importlinter]
root_package = agentecs

[importlinter:contract:layers]
name = Kind layers
type = layers
layers =
    agentecs.adapters
    agentecs.api
    agentecs.services
    agentecs.functions
    agentecs.protocols
    agentecs.models

[importlinter:contract:services_independent]
name = Services do not import each other
type = independence
modules =
    agentecs.services.registry
    agentecs.services.storage
    agentecs.services.scheduler
    agentecs.services.world

[importlinter:contract:no_root_facade_imports]
name = Internal modules avoid root facade imports
type = forbidden
source_modules =
    agentecs.models
    agentecs.protocols
    agentecs.functions
    agentecs.services
    agentecs.api
    agentecs.adapters
forbidden_modules =
    agentecs
as_packages = false
